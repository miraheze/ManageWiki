{
	"private": true,
	"scripts": {
		"test": "npm -s run lint:js && npm -s run lint:styles && npm -s run lint:i18n",
		"lint:fix:js": "npm -s run lint:js -- --fix",
		"lint:fix:styles": "npm -s run lint:styles -- --fix",
		"lint:js": "eslint --cache --max-warnings 0 .",
		"lint:styles": "stylelint \"**/*.{less,css}\"",
		"lint:fix:i18n": "npm -s run lint:i18n:order -- --fix",
		"lint:i18n": "banana-checker --requireLowerCase=0 i18n/ && npm -s run lint:i18n:order",
		"lint:i18n:order": "eslint --cache --max-warnings 0 i18n/"
	},
	"devDependencies": {
		"eslint-config-wikimedia": "0.32.6",
		"eslint-plugin-jsonc": "3.4.2",
		"grunt-banana-checker": "0.13.0",
		"stylelint-config-idiomatic-order": "10.0.0",
		"stylelint-config-wikimedia": "0.19.4"
	},
	"peerDependencies": {
		"postcss-less": "6.0.0"
	}
}
